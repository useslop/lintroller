{
  "name": "@subsweep/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lintroller: static Vite + React app for Subscription Sweep. The CSV is read in the browser; the page makes no network requests after load.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-static.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@subsweep/data": "*",
    "@subsweep/engine": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
